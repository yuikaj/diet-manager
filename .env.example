# Copy this file to .env and fill in your own keys. .env is gitignored.

# USDA FoodData Central (free): https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your_usda_api_key_here

# Google Gemini (free tier, no card required): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
